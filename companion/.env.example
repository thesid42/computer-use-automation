# Copy to `.env` (gitignored, never committed) and fill in your own key:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (macOS/Linux)
#
# Swap models by commenting/uncommenting one zero-price preset block below.
# The companion reads these at startup (see src/main.ts `dotenv/config`).

# --- Preset 1: OpenRouter Nex N2.5 Mini (tested free accessibility/tool model) ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=nex-agi/nex-n2.5-mini:free
LLM_ACTION_MODE=tool
LLM_RESPONSE_FORMAT=none
LLM_TIMEOUT_MS=45000
LLM_OBSERVATION_MODE=accessibility

# --- Preset 2: OpenRouter Ling 3.0 Flash VL (tested free multimodal/tool model) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=inclusionai/ling-3.0-flash-vl:free
# LLM_ACTION_MODE=tool
# LLM_RESPONSE_FORMAT=none
# LLM_TIMEOUT_MS=45000
# LLM_OBSERVATION_MODE=multimodal

# --- Preset 3: OpenRouter Gemma 4 26B (catalog free; benchmark rate-limited) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=google/gemma-4-26b-a4b-it:free
# LLM_ACTION_MODE=tool
# LLM_RESPONSE_FORMAT=none
# LLM_TIMEOUT_MS=45000

# Target back-office app under test (no rebuild needed to point elsewhere).
TARGET_URL=http://127.0.0.1:3001
