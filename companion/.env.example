# Copy to `.env` (gitignored, never committed) and fill in your own key:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (macOS/Linux)
#
# Swap models by commenting/uncommenting one preset block below.
# The companion reads these at startup (see src/main.ts `dotenv/config`).

# --- Preset 1: NVIDIA NIM (default) ---
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# --- Preset 2: OpenRouter fallback ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=qwen/qwen3-vl-30b-a3b-instruct

# --- Preset 3: Fireworks fallback (manual alternative) ---
# LLM_BASE_URL=https://api.fireworks.ai/inference/v1
# LLM_API_KEY=
# LLM_MODEL=accounts/fireworks/models/qwen3p7-plus

# Target back-office app under test (no rebuild needed to point elsewhere).
TARGET_URL=http://127.0.0.1:3001
